<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AuroraShelf" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.AuroraShelf.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F9FE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AuroraShelf</item>
    </style>
</resources>
